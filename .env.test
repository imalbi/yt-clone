# Valori fittizi per i test: le chiamate di rete sono sempre mockate.
# Vite carica questo file al posto di `.env` quando mode=test, quindi la
# suite non dipende da credenziali vere e gira su qualsiasi clone.
YOUTUBE_API_KEY=test-key
PUBLIC_YOUTUBE_CLIENT_ID=test-client-id
YOUTUBE_CLIENT_SECRET=test-secret
PUBLIC_REDIRECT_URL=http://localhost:5173/api/auth/callback
