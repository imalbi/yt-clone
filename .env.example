# Copia questo file in `.env` e riempi i valori.
# Credenziali da https://console.cloud.google.com/apis/credentials
# (abilita prima "YouTube Data API v3" sul progetto)

# --- Obbligatoria ---
# Chiave API per le chiamate pubbliche: home, ricerca, video, canali, commenti.
# Vive nel namespace privato: SvelteKit rifiuta di compilare se finisce lato client.
YOUTUBE_API_KEY=

# --- Opzionali ---
# Senza queste l'app resta pienamente navigabile in sola lettura; login, like e
# iscrizioni rispondono 503 invece di rompersi. Servono solo per le funzioni utente.
# Console Cloud > Credenziali > Crea credenziali > ID client OAuth 2.0 > Applicazione web.
PUBLIC_YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Deve combaciare esattamente con un "Authorized redirect URI" del client OAuth.
PUBLIC_REDIRECT_URL=http://localhost:5173/api/auth/callback
